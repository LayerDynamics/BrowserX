# ============================================================
# BrowserX Environment Variables
# Copy to .env and fill in values for production deployment.
# NEVER commit .env — it is in .gitignore.
# ============================================================

# ── Digital Ocean / SSH ──────────────────────────────────────
# IP address of your Digital Ocean Droplet
DROPLET_IP=

# SSH username (root for a fresh Ubuntu Droplet)
DO_SSH_USER=root

# Path to SSH private key on your local machine
DO_SSH_KEY_PATH=~/.ssh/id_rsa

# ── GitHub Container Registry ────────────────────────────────
# GitHub username or org (lowercase)
GHCR_USERNAME=layerdynamics

# GitHub Personal Access Token with packages:write scope
# Create at: https://github.com/settings/tokens/new
# Required scopes: write:packages, read:packages
GHCR_TOKEN=

# Full repository name (owner/repo)
GITHUB_REPOSITORY=LayerDynamics/BrowserX

# ── Doc Site ─────────────────────────────────────────────────
# URL of the BrowserX API service
# In Docker: http://browserx-api:8080 (internal service name)
# Locally:   http://localhost:8080
BROWSERX_API_URL=http://browserx-api:8080

# Astro SSR standalone server bind settings
HOST=0.0.0.0
PORT=3000

# ── BrowserX API Service ─────────────────────────────────────
DENO_ENV=production
BROWSERX_API_PORT=8080

# ── Nginx / TLS (optional) ───────────────────────────────────
# Your public domain name (set in nginx config for production TLS)
DOMAIN=browserx.dev

# TLS certificate paths (mounted into nginx container from nginx_certs volume)
# TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
# TLS_KEY_PATH=/etc/nginx/certs/privkey.pem

# ── GitHub Actions Secrets (set in GitHub, not here) ─────────
# GitHub repo → Settings → Secrets and variables → Actions:
#
#   DROPLET_IP       — same value as DROPLET_IP above
#   DROPLET_SSH_KEY  — full PEM contents of the SSH private key
#   GITHUB_TOKEN     — automatically provided by GitHub Actions
