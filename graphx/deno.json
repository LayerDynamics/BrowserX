{
  "name": "@browserx/graphx",
  "version": "0.1.0",
  "exports": {
    ".": "./mod.ts",
    "./graph": "./src/graph/mod.ts",
    "./algorithms": "./src/algorithms/mod.ts",
    "./layout": "./src/layout/mod.ts",
    "./svg": "./src/svg/mod.ts",
    "./types": "./src/types.ts",
    "./canvas": "./src/canvas/mod.ts",
    "./adapters": "./src/canvas/adapters/mod.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.16"
  },
  "tasks": {
    "check": "deno check mod.ts",
    "check:watch": "deno check --watch mod.ts",
    "test": "deno test --allow-all tests/",
    "test:unit": "deno test --allow-all tests/",
    "test:watch": "deno test --allow-all --watch tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "lint": {
    "rules": { "tags": ["recommended"] },
    "exclude": ["node_modules", ".git"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": ["node_modules", ".git"]
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns", "deno.unstable", "esnext"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true
  }
}
